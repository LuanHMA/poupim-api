generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PAID
  PENDING
  RECEIVED
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(191)
  email        String        @unique @db.VarChar(191)
  password     String        @db.VarChar(191)
  created_at   DateTime      @default(now())
  transactions Transaction[]

  @@map("users")
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  icon         String        @default("tag") @db.VarChar(64)
  color        String        @default("#6366F1") @db.VarChar(7)
  created_at   DateTime      @default(now())
  transactions Transaction[]

  @@map("categories")
}

model Transaction {
  id               Int               @id @default(autoincrement())
  amount           Decimal           @db.Decimal(12, 2)
  status           TransactionStatus
  ignore           Boolean           @default(false)
  fixed            Boolean           @default(false)
  transaction_date DateTime          @db.Timestamptz(3)
  month            Int
  year             Int
  description      String            @db.VarChar(191)
  observation      String            @db.VarChar(191)
  type             TransactionType
  category_id      Int
  user_id          Int
  created_at       DateTime          @default(now())
  category         Category          @relation(fields: [category_id], references: [id], onDelete: Restrict)
  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([month, year])
  @@index([user_id])
  @@index([category_id])
  @@index([user_id, transaction_date])
  @@map("transactions")
}
